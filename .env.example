# Naver News Search API credentials
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# Kakao Daum Web Search API credential
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# SNS official API credentials
X_BEARER_TOKEN=your_x_api_bearer_token
META_ACCESS_TOKEN=your_meta_graph_api_access_token
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_IG_USER_ID=your_instagram_professional_account_id
META_PAGE_IDS=your_comma_separated_facebook_page_ids

# SMTP credential for orchestration keyword notifications
# Leave SMTP_PASSWORD empty for dry-run behavior.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sender_email@example.com
SMTP_FROM=your_sender_email@example.com
SMTP_PASSWORD=your_gmail_app_password
