      "wait_state": "attached"
    },
    {
      "name": "extract_title",
      "xpath": "//h1",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    },
    {
      "name": "extract_body",
      "xpath": "//*[@id=\"main-content\"]/section[2]/div/div[2]",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    }
