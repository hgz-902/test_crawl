  "steps": [
    {
      "name": "open_detail",
      "xpath": "//*[@id=\"results\"]/div[2]/div[2]/div/div[2]/div/article[1]/h3/a",
      "xpath_2": "//*[@id=\"results\"]/div[2]/div[2]/div/div[2]/div/article[2]/h3/a",
      "loop": true,
      "loop_mode": "items",
      "loop_limit": 3,
      "action": "click",
