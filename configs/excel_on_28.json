{
  "name": "유럽 교통환경연맹",
  "start_url": "https://www.transportenvironment.org/search/results?section=article&page={search_term}",
  "output_dir": "outputs/transportenvironment",
  "timeout_ms": 45000,
  "renderer": "playwright",
  "headless": true,
  "ignore_https_errors": false,
  "notes": "",
