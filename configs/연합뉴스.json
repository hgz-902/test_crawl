  "start_url": "https://www.yna.co.kr/news?site=navi_latest_depth01&page={search_term}",
  "steps": [
    {
      "name": "open_detail",
      "xpath": "//*[@id=\"container\"]/div[2]/div[2]/div[1]/section/div/ul/li[@data-cid][1]/div/div/strong/a",
      "xpath_2": "//*[@id=\"container\"]/div[2]/div[2]/div[1]/section/div/ul/li[@data-cid][2]/div/div/strong/a",
      "loop": true,
      "loop_mode": "items",
      "action": "click",
      "open_mode": "same_tab",
      "wait_state": "attached"
    },
    {
      "name": "extract_date",
      "xpath": "//*[@id=\"newsUpdateTime01\"]/p[2]",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    },
    {
      "name": "extract_title",
      "xpath": "//*[@id=\"container\"]/div[2]/div[1]/header/h1",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    },
    {
      "name": "extract_body",
      "xpath": "//*[@id=\"articleWrap\"]/div[1]",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    }
  ],
  "timeout_ms": 30000,
