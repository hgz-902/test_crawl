{
  "name": "마켓인사이트",
  "start_url": "https://marketinsight.hankyung.com/freenews?page={search_term}",
  "output_dir": "outputs/marketinsight",
  "timeout_ms": 30000,
  "renderer": "playwright",
  "headless": true,
  "ignore_https_errors": false,
  "notes": "마켓인사이트는 API/RSS형이 아니라 원본 연합뉴스형 뉴스 실행단계 구조로 관리한다. 검색어 목록이 비어 있으면 Free News 최신 목록을 수집한 뒤 필터 목록 키워드로 분리한다. 소스코드 수정 없이 최신 기사 목록의 기사 링크를 열고 제목과 본문을 추출한다.",
  "search_terms": [],
  "filter_terms": [
    "CFO",
    "VC"
  ],
  "steps": [
    {
      "name": "open_detail",
      "xpath": "//*[@id=\"contents\"]/div/div/div[1]/ul/li[1]/div/h3/a",
      "xpath_2": "//*[@id=\"contents\"]/div/div/div[1]/ul/li[2]/div/h3/a",
      "loop": true,
      "loop_mode": "items",
      "loop_limit": 20,
      "action": "click",
      "open_mode": "same_tab",
      "wait_state": "attached"
    },
    {
      "name": "extract_title",
      "xpath": "//*[@id=\"contents\"]/article/div/div[1]/div[1]/h1",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    },
    {
      "name": "extract_body",
      "xpath": "//*[@id=\"contents\"]/article/div/div[1]/div[2]/div[1]",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    }
  ],
  "created_at": "2026-05-15T00:00:00+09:00",
  "updated_at": "2026-05-21T14:00:27+09:00"
}
