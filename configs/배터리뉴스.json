{
  "name": "배터리뉴스",
  "start_url": "https://battery-news.de/en/home/page/{search_term}/",
  "output_dir": "outputs/battery_news",
  "timeout_ms": 45000,
  "renderer": "playwright",
  "headless": true,
  "ignore_https_errors": false,
  "notes": "extract_body는 개발자도구에서 직접 수집한 XPath로는 실패하여, AI의 도움을 받아 작성",
  "search_terms": [
    "1"
  ],
  "filter_terms": [
    "EV",
    "Electric Vehicle",
    "ESS",
    "China",
    "Korea",
    "Lithium",
    "Lithium ion Battery"
  ],
  "steps": [
    {
      "name": "open_detail",
      "xpath": "//*[@id=\"content\"]/div/div/section[3]/div/div[1]/div/div[2]/div/section/article[1]/div/div[2]/h3/div/a",
      "xpath_2": "//*[@id=\"content\"]/div/div/section[3]/div/div[1]/div/div[2]/div/section/article[2]/div/div[2]/h3/div/a",
      "loop": true,
      "loop_mode": "items",
      "loop_limit": 3,
      "action": "click",
      "open_mode": "same_tab",
      "wait_state": "attached"
    },
    {
      "name": "extract_title",
      "xpath": "//h1",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    },
    {
      "name": "extract_body",
      "xpath": "(//*[contains(@class,\"post-content\")])[1]",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    }
  ],
  "created_at": "2026-05-27T11:37:00+09:00",
  "updated_at": "2026-05-30T10:16:51+09:00"
}
