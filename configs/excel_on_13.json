{
  "name": "중국 상무부",
  "start_url": "https://search.mofcom.gov.cn/allSearch/?keyWordType=all&siteId=0&acSuggest={search_term}",
  "output_dir": "outputs/mofcom_cn",
  "timeout_ms": 45000,
  "renderer": "playwright",
  "headless": true,
  "ignore_https_errors": false,
  "notes": "모든 상세 페이지의 DOM 구조가 같지 않아, 몇몇은 수집 가능하고 몇몇은 실패.\n페이지 파라미터 불가. 검색어 파라미터만 가능",
  "search_terms": [
    "鋰電池",
    "动力电池",
    "新能源汽車"
  ],
  "filter_terms": [],
  "steps": [
    {
      "name": "open_detail",
      "xpath": "/html/body/section/section/div[3]/div/div[2]/ul/li[1]/div[1]/h3/a",
      "xpath_2": "/html/body/section/section/div[3]/div/div[2]/ul/li[2]/div[1]/h3/a",
      "loop": true,
      "loop_mode": "items",
      "loop_limit": 3,
      "action": "click",
      "open_mode": "popup",
      "wait_state": "attached"
    },
    {
      "name": "extract_title",
      "xpath": "//*[@id=\"artitle\"]",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    },
    {
      "name": "extract_body",
      "xpath": "//*[@id=\"zoom\"]",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    }
  ],
