{
  "name": "중국 재정부",
  "start_url": "https://www.mof.gov.cn/zhengwuxinxi/caizhengxinwen/index{search_term}.htm",
  "output_dir": "outputs/mof_gov_cn_zheng",
  "timeout_ms": 45000,
  "renderer": "playwright",
  "headless": true,
  "ignore_https_errors": false,
  "notes": "페이지 파라미터가 특이한 구조. (index.html, index_1.html, index_2.html 과 같이 사용)\n페이지의 open_detail XPath가 제대로 반복될 수 없는 구조로 설계되어있어 소스코드 수정이 필요함. (괄호형 전역 Xpath loop 지원이 필요)\n현재 소스코드상 NULL값을 넣을 수는 없어보임. 수정 필요.",
  "search_terms": [
    "_1",
    "_2"
  ],
  "filter_terms": [
    "鋰電池",
    "动力电池",
    "新能源汽車",
    "外地企業",
    "中外合资"
  ],
  "steps": [
    {
      "name": "open_detail",
      "xpath": "(//ul[contains(@class,\"xwfb_listbox\")]/li/a)[1]",
      "xpath_2": "(//ul[contains(@class,\"xwfb_listbox\")]/li/a)[2]",
      "loop": true,
      "loop_mode": "items",
      "loop_limit": 3,
      "action": "click",
      "open_mode": "popup",
      "wait_state": "attached"
    },
    {
      "name": "extract_title",
      "xpath": "/html/body/div[4]/div[1]/h2",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    },
    {
      "name": "extract_body",
      "xpath": "/html/body/div[4]/div[1]/div[2]/div[1]/div/div",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    }
  ],
  "created_at": "2026-05-27T11:45:00+09:00",
  "updated_at": "2026-05-27T14:58:41+09:00"
}
