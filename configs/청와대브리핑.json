    {
      "name": "download_text",
      "xpath": "//*[@id=\"containerArea\"]/div/div[2]/article/div/div[1]/dl/dd/div",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    }
  ],
