{
  "name": "청와대브리핑",
  "start_url": "https://www.president.go.kr/briefings",
  "output_dir": "outputs/president",
  "timeout_ms": 30000,
  "renderer": "playwright",
  "headless": false,
  "ignore_https_errors": false,
  "notes": "",
