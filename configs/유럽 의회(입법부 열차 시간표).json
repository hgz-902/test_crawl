{
  "name": "유럽 의회(입법부 열차 시간표)",
  "start_url": "https://www.europarl.europa.eu/legislative-train/search?pageNumber={search_term}&keywords=&_selectedStates=1&_selectedPriorities=1&_selectedCommittees=1&_selectedTypes=1&_selectedPackages=1&_selectedTags=1",
  "output_dir": "outputs/europarl_legislative_train",
  "timeout_ms": 45000,
  "renderer": "playwright",
  "headless": true,
  "ignore_https_errors": false,
  "notes": "",
  "search_terms": [
    "1"
  ],
  "filter_terms": [
    "CSRD",
    "CSDDD",
    "CBAM",
    "IAA",
    "Industrial Acceleration Act",
    "Battery booster strategy",
    "Battery regulation",
    "ESRS",
    "Battery Passport"
  ],
  "steps": [
    {
      "name": "open_detail",
      "xpath": "//*[@id=\"results\"]/div[2]/ol/li[1]/h3/a",
      "xpath_2": "//*[@id=\"results\"]/div[2]/ol/li[2]/h3/a",
      "loop": true,
      "loop_mode": "items",
      "loop_limit": 3,
      "action": "click",
      "open_mode": "same_tab",
      "wait_state": "attached"
    },
    {
      "name": "extract_title",
      "xpath": "//*[@id=\"content\"]/div[1]",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    },
    {
      "name": "extract_body",
      "xpath": "//*[@id=\"content\"]/div[2]",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    },
    {
      "name": "download_file",
      "xpath": "//*[@id=\"contextPdf\"]",
      "loop": false,
      "action": "download",
      "wait_state": "attached"
    }
  ],
  "created_at": "2026-05-27T11:50:00+09:00",
  "updated_at": "2026-05-30T10:19:10+09:00"
}
