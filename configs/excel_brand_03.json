  "steps": [
    {
      "name": "open_detail",
      "xpath": "/html/body/div[3]/section[5]/div/div/div[2]/div/div[3]/div/a",
      "xpath_2": "/html/body/div[3]/section[5]/div/div/div[2]/div/div[4]/div/a",
