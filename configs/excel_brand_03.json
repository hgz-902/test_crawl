    {
      "name": "extract_title",
      "xpath": "//h1",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    },
    {
      "name": "extract_body",
      "xpath": "//body",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    }
