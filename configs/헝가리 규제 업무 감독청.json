{
  "name": "헝가리 규제 업무 감독청",
  "start_url": "https://sztfh.hu/hatosag/hirek/page/{search_term}/",
  "output_dir": "outputs/sztfh_hu",
  "timeout_ms": 45000,
  "renderer": "playwright",
  "headless": true,
  "ignore_https_errors": false,
  "notes": "",
  "search_terms": [
    "1",
    "2"
  ],
  "filter_terms": [
    "ESG",
