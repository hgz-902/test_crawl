  ],
  "steps": [
    {
      "name": "open_detail",
      "xpath": "//*[@id=\"content\"]/div[1]/article[1]/div[3]/h2/a",
      "xpath_2": "//*[@id=\"content\"]/div[1]/article[2]/div[3]/h2/a",
      "loop": true,
      "loop_mode": "items",
      "loop_limit": 3,
      "action": "click",
      "open_mode": "same_tab",
      "wait_state": "attached"
    },
    {
      "name": "extract_title",
      "xpath": "//*[@id=\"content\"]/article/div[3]/h2",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    },
    {
      "name": "extract_body",
      "xpath": "//*[@id=\"content\"]/article/div[3]/div[2]",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    }
  ],
