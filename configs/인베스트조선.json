    "SK인천석유화학",
    "SK온",
    "대한상의"
  ],
  "headless": true,
  "ignore_https_errors": false,
  "name": "인베스트조선",
  "notes": "인베스트조선은 API/RSS형이 아니라 원본 연합뉴스형 뉴스 실행단계 구조로 관리한다. 검색어 목록이 비어 있으면 전체 기사 목록(catid=2) 1페이지의 최신 기사 목록을 수집한 뒤 필터 목록 키워드로 분리한다. 전체 기사 목록은 1페이지당 10개 기사만 노출되므로 loop_limit을 20으로 설정해도 실제 1페이지에서는 최대 10개만 수집된다.",
  "output_dir": "outputs/investchosun",
  "renderer": "playwright",
  "search_terms": [
    "1",
    "2",
    "3"
  ],
  "start_url": "https://www.investchosun.com/svc/news/list.html?catid=2&pn={search_term}",
  "steps": [
    {
      "name": "open_detail",
      "xpath": "//*[@id=\"section\"]/section/div/div[1]/div[2]/div[2]/ul/li[1]/div/dl/dt/a",
      "xpath_2": "//*[@id=\"section\"]/section/div/div[1]/div[2]/div[2]/ul/li[2]/div/dl/dt/a",
      "loop": true,
      "loop_mode": "items",
      "action": "click",
      "open_mode": "same_tab",
      "wait_state": "attached"
    },
    {
      "name": "extract_title",
      "xpath": "/html/body/div[3]/div[2]/div[1]/div[1]/div[1]",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    },
    {
      "name": "extract_body",
      "xpath": "//*[@id=\"article\"]/ul/li",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    }
  ],
  "timeout_ms": 60000,
  "updated_at": "2026-06-23T17:22:36+09:00",
  "category": "",
  "crawling_type": ""
}
