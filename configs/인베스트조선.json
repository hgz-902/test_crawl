{
  "name": "인베스트조선",
  "start_url": "https://www.investchosun.com/svc/news/search.html?q={search_term}&pn=1",
  "output_dir": "outputs/investchosun",
  "timeout_ms": 60000,
  "renderer": "playwright",
  "headless": true,
  "ignore_https_errors": false,
  "notes": "인베스트조선은 API/RSS형이 아니라 원본 연합뉴스형 뉴스 실행단계 구조로 관리한다.",
  "search_terms": [
    "최태원",
    "SK",
    "SK이노베이션",
    "SK E&S",
    "SK에너지",
    "SK지오센트릭",
    "SK어스온",
    "SK엔무브",
    "SK아이이테크놀로지",
    "SK인천석유화학",
    "SK온",
    "대한상의"
  ],
  "filter_terms": [],
  "steps": [
    {
      "name": "open_detail",
      "xpath": "//*[@id=\"section\"]/section/div/div[1]/div[2]/div[2]/ul/li[1]/div/dl/dt/a",
      "xpath_2": "//*[@id=\"section\"]/section/div/div[1]/div[2]/div[2]/ul/li[2]/div/dl/dt/a",
      "loop": true,
      "loop_mode": "items",
      "loop_limit": 10,
      "action": "click",
      "open_mode": "same_tab",
      "wait_state": "attached"
    },
    {
      "name": "extract_title",
      "xpath": "//div[contains(@class, 'art_title')]/div[contains(@class, 'title')]",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    },
    {
      "name": "extract_body",
      "xpath": "//div[@id='article']",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    }
  ],
  "created_at": "2026-05-14T21:00:00+09:00",
  "updated_at": "2026-05-19T11:05:20+09:00"
}
