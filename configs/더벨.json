{
  "name": "더벨",
  "start_url": "https://www.thebell.co.kr/search/search.asp?page=1&ord=NEWSDATE&section=NEWS&keyword={search_term}",
  "output_dir": "outputs/thebell",
  "timeout_ms": 60000,
  "renderer": "playwright",
  "headless": true,
  "ignore_https_errors": false,
  "notes": "더벨은 네이버/다음 API형이 아니라 실행 단계에서 XPath를 직접 관리한다. 본문은 유료/로그인이 필요하여 모든 내용을 수집하지 못한다.",
  "search_terms": [
    "최태원",
    "SK",
    "SK이노베이션",
    "대한상의"
  ],
  "filter_terms": [],
  "steps": [
    {
      "name": "open_detail",
      "xpath": "//div[contains(@class, 'newsList')]/ul/li[1]/dl/dt/a",
      "xpath_2": "//div[contains(@class, 'newsList')]/ul/li[2]/dl/dt/a",
      "loop": true,
      "loop_mode": "items",
      "loop_limit": 10,
      "action": "click",
      "open_mode": "same_tab",
      "wait_state": "attached"
    },
    {
      "name": "extract_title",
      "xpath": "//div[contains(@class, 'viewHead')]//p[contains(@class, 'tit')]",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    },
    {
      "name": "extract_body",
      "xpath": "//div[contains(@class, 'viewSection')]",
      "exclude_xpath": ".//script | .//style | .//*[contains(@class, 'newLoginBox') or contains(@class, 'login') or contains(@class, 'Login') or contains(@id, 'login') or contains(@id, 'Login')]",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    }
  ],
  "created_at": "2026-05-14T17:20:12+09:00",
  "updated_at": "2026-05-14T20:37:34+09:00"
}
