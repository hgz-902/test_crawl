  "steps": [
    {
      "name": "open_detail",
      "xpath": "//*[@id=\"state-list\"]/div[1]/table/tbody/tr[1]/td[2]/a",
      "xpath_2": "//*[@id=\"state-list\"]/div[1]/table/tbody/tr[2]/td[2]/a",
      "loop": true,
      "loop_mode": "items",
      "action": "click",
      "open_mode": "popup",
      "wait_state": "attached"
    },
    {
      "name": "extract_date",
      "xpath": "//*[@id=\"meta-info-sect\"]/div[2]/div[1]/div[2]",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    },
    {
      "name": "extract_title",
      "xpath": "//*[@id=\"content\"]/div[1]/div/h3",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    },
    {
      "name": "extract_text",
      "xpath": "//*[@id=\"content\"]",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    },
    {
      "name": "download_file",
      "xpath": "//*[@id=\"meta-info-sect\"]//a[contains(@data-url, \"/bill/bi/bill/detail/downloadDtlZip.do\")]",
      "loop": false,
      "action": "download",
      "wait_state": "attached"
    }
