{
  "name": "미 연방 관보",
  "start_url": "https://www.federalregister.gov/documents/search?conditions%5Bsearch_type_id%5D=3",
  "output_dir": "outputs/fedralregister",
  "timeout_ms": 45000,
  "renderer": "playwright",
  "headless": true,
  "ignore_https_errors": false,
  "notes": "해당 사이트에서 Playwright 차단하고 있음. 소스코드 수정이 필요\n페이지 파라미터를 사용할 수는 있으나, Open_detail XPath가 페이지와 관계없이 계속 증가하는 구조라, 페이지 파라미터 사용 불가",
  "search_terms": [],
  "filter_terms": [
    "EV",
    "Electric Vehicle",
    "ESS",
    "China",
    "Korea",
    "Lithium",
    "Anode",
    "Cathode",
    "Lithium ion Battery",
    "Battery"
  ],
  "steps": [
    {
      "name": "open_detail",
      "xpath": "//*[@id=\"entries\"]/ul/li[1]/div/h5/a",
      "xpath_2": "//*[@id=\"entries\"]/ul/li[2]/div/h5/a",
      "loop": true,
      "loop_mode": "items",
      "loop_limit": 3,
      "action": "click",
      "open_mode": "same_tab",
      "wait_state": "attached"
    },
    {
      "name": "extract_title",
      "xpath": "//*[@id=\"metadata_content_area\"]/h1",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    },
    {
      "name": "extract_body",
      "xpath": "//*[@id=\"fulltext_content_area\"]",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    }
  ],
  "created_at": "2026-05-27T11:40:00+09:00",
  "updated_at": "2026-05-27T14:02:27+09:00"
}
