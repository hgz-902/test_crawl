{
  "name": "중국 산업정보부",
  "start_url": "https://www.most.gov.cn/kjbgz/index{search_term}.html",
  "output_dir": "outputs/most_gov_cn",
  "timeout_ms": 45000,
  "renderer": "playwright",
  "headless": true,
  "ignore_https_errors": false,
  "notes": "페이지 파라미터가 특이한 구조. (index.html, index_1.html, index_2.html 과 같이 사용)\n현재 소스코드상 NULL값을 넣을 수는 없어보임. 수정 필요.",
  "search_terms": [
    "_1",
    "_2"
  ],
  "filter_terms": [
    "鋰電池",
    "新能源汽車"
  ],
  "steps": [
    {
      "name": "open_detail",
      "xpath": "/html/body/div[6]/ul/li[1]/a",
      "xpath_2": "/html/body/div[6]/ul/li[2]/a",
      "loop": true,
      "loop_mode": "items",
      "loop_limit": 3,
      "action": "click",
      "open_mode": "popup",
      "wait_state": "attached"
    },
    {
      "name": "extract_title",
      "xpath": "/html/body/div[7]/div[2]/div[1]",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    },
    {
      "name": "extract_body",
      "xpath": "/html/body/div[7]/div[2]/div[3]/div",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    }
  ],
  "created_at": "2026-05-27T11:44:00+09:00",
  "updated_at": "2026-05-27T14:41:14+09:00"
}
