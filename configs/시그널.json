{
  "name": "시그널",
  "start_url": "https://signal.sedaily.com/search?word={search_term}",
  "output_dir": "outputs/signal",
  "timeout_ms": 30000,
  "renderer": "playwright",
  "headless": true,
  "ignore_https_errors": false,
  "notes": "시그널은 API/RSS형이 아니라 원본 연합뉴스형 뉴스 실행단계 구조로 관리한다. 소스코드 수정 없이 검색 결과 목록의 기사 링크를 열고 제목과 본문을 추출한다.",
  "search_terms": [
    "최태원",
    "SK",
    "SK이노베이션",
    "SK E&S",
    "SK에너지",
    "SK지오센트릭",
    "SK어스온",
    "SK엔무브",
    "SK아이이테크놀로지",
    "SK인천석유화학",
    "SK온",
    "대한상의"
  ],
  "filter_terms": [],
  "steps": [
    {
      "name": "open_detail",
      "xpath": "//*[@id=\"l-left-scroll-in\"]/div/div/div/ul/li[1]/div/dl/dt/a",
      "xpath_2": "//*[@id=\"l-left-scroll-in\"]/div/div/div/ul/li[2]/div/dl/dt/a",
      "loop": true,
      "loop_mode": "items",
      "loop_limit": 10,
      "action": "click",
      "open_mode": "same_tab",
      "wait_state": "attached"
    },
    {
      "name": "extract_title",
      "xpath": "//*[@id=\"mainTitle\"]",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    },
    {
      "name": "extract_body",
      "xpath": "//*[@id=\"v-left-scroll-in\"]/div[2]",
      "loop": false,
      "action": "extract",
      "attr": "text",
      "wait_state": "attached"
    }
  ],
  "created_at": "2026-05-15T00:00:00+09:00",
  "updated_at": "2026-05-19T11:05:33+09:00"
}
